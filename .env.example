# Servidor. NODE_ENV controla cookies Secure y detalle de logs.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Número exacto de proxies confiables delante de Express; 0 para conexión directa.
TRUST_PROXY=0

# PostgreSQL local de docker-compose.yml. Cambie credenciales fuera de desarrollo.
DATABASE_URL="postgresql://cabales:cabales_local_only@127.0.0.1:5433/cabales?schema=public"

# Origen exacto del cliente React (cabales-app / Vite). Incluye localhost y 127.0.0.1. No use * con cookies.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Origen público del cliente (enlaces de correo) y de esta API (URLs firmadas de descarga).
APP_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000

# Sesiones opacas revocables.
SESSION_TTL_HOURS=168
COOKIE_NAME=cabales_session

# Límites de solicitudes. memory sirve a una sola instancia; producción exige redis compartido.
RATE_LIMIT_STORE=memory
# Redis de docker-compose.yml (puerto 6380 en el host). Obligatorio si RATE_LIMIT_STORE=redis.
REDIS_URL=
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
RECOVERY_RATE_LIMIT_MAX=5
INVITATION_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=30
OCR_RATE_LIMIT_MAX=20
EXPENSE_RATE_LIMIT_MAX=60
PRIVACY_RATE_LIMIT_MAX=10
PUSH_SUBSCRIPTION_RATE_LIMIT_MAX=20

# Vigencias de enlaces de un solo uso.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7

# Correo. logging no envía nada y nunca registra el contenido ni tokens; http usa una API JSON
# compatible con Resend. La clave va solo en el entorno del servidor, nunca en el repositorio.
EMAIL_PROVIDER=logging
EMAIL_FROM="Cabales <no-reply@cabales.local>"
EMAIL_HTTP_URL=
EMAIL_HTTP_API_KEY=
# Tiempo máximo por llamada a proveedores externos (correo, OCR).
EXTERNAL_TIMEOUT_MS=8000

# Documentos. local guarda en disco (fuera de git); s3 usa URLs presignadas y funciona con MinIO.
# En producción el secreto debe tener al menos 32 caracteres aleatorios.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760

# OCR. disabled responde 503 OCR_PROVIDER_DISABLED; http delega; local es solo desarrollo/pruebas y nunca producción.
OCR_PROVIDER=disabled
OCR_HTTP_URL=
OCR_HTTP_API_KEY=
OCR_TESSERACT_LANGS=spa+eng
OCR_TESSERACT_LANG_PATH=
OCR_MAX_ATTEMPTS=3

# Web Push. Genera una pareja con: npx web-push generate-vapid-keys
# webpush exige las tres variables VAPID; nunca las versionar ni registrar.
PUSH_PROVIDER=disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Exportación CSV acotada y rate-limited.
STATISTICS_EXPORT_MAX_ROWS=1000
STATISTICS_EXPORT_RATE_LIMIT_MAX=10

# Privacidad y retención en días. Valores provisionales: el responsable legal debe confirmarlos.
PRIVACY_EXPORT_TTL_DAYS=7
RETENTION_TOKEN_DAYS=7
RETENTION_SESSION_DAYS=30
RETENTION_INVITATION_DAYS=90
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_DOCUMENT_LOG_DAYS=365
RETENTION_OCR_DAYS=90
RETENTION_NOTIFICATION_DAYS=180
RETENTION_PRIVACY_REQUEST_DAYS=730
