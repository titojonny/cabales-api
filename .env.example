# Configuración del servidor Express
PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL (local o contenedor Docker)
DATABASE_URL="postgresql://cabales_user:cabales_secret@localhost:5434/cabales_db?schema=public"

# Frontend URL para CORS
FRONTEND_URL="http://localhost:4200"

# Almacenamiento de Comprobantes (local | s3 | r2)
STORAGE_DRIVER="local"

# Configuración Cloudflare R2 / AWS S3 (Opcional - solo si STORAGE_DRIVER="s3" o "r2")
# Para Cloudflare R2:
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="cabales-comprobantes"
# S3_ACCESS_KEY_ID="tu_r2_access_key_id"
# S3_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
# S3_PUBLIC_URL="https://pub-xxxx.r2.dev" # o tu dominio personalizado https://cdn.cabales.app

# (Para el futuro) La llave secreta para los tokens de inicio de sesión
# JWT_SECRET="super-secreto-cabales-2026"