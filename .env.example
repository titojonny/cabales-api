# Servidor. NODE_ENV controla cookies Secure y detalle de logs.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Número exacto de proxies confiables delante de Express; 0 para conexión directa.
TRUST_PROXY=0

# PostgreSQL local de docker-compose.yml. Cambie credenciales fuera de desarrollo.
DATABASE_URL="postgresql://cabales:cabales_local_only@localhost:5432/cabales?schema=public"

# Orígenes exactos, separados por coma. No use * con cookies.
# Incluye Vite, Angular CLI, Ionic CLI y WebViews nativos locales.
CORS_ORIGINS="http://localhost:5173,http://localhost:4200,http://127.0.0.1:4200,http://localhost:8100,http://127.0.0.1:8100,capacitor://localhost,ionic://localhost"

# Sesiones opacas revocables.
SESSION_TTL_HOURS=168
COOKIE_NAME=cabales_session

# Límites por IP para una sola instancia. Producción distribuida requiere store compartido.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Almacenamiento de comprobantes: local | s3 | r2
STORAGE_DRIVER="local"

# Cloudflare R2 / AWS S3. Solo si STORAGE_DRIVER es s3 o r2.
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="cabales-comprobantes"
# S3_ACCESS_KEY_ID="tu_r2_access_key_id"
# S3_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
# S3_PUBLIC_URL="https://cdn.cabales.app"
# S3_FORCE_PATH_STYLE="false"
