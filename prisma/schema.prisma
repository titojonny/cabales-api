// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS DE ESTADO ---

enum EstadoEvento {
  ACTIVO
  CERRADO
}

enum EstadoTransaccion {
  PENDIENTE
  EN_REVISION
  EN_DISPUTA
  COMPLETADO
}

// --- 1. MODELOS PRINCIPALES ---
// REGLA DE ORO DEL DINERO: todos los montos se guardan en CENTAVOS (Int).
// Nunca usar Float para dinero: evita errores de precisión y hace trivial
// el redondeo a 2 decimales y el reparto de centavos sobrantes.

model Usuario {
  id             String   @id @default(uuid())
  nombre         String
  email          String   @unique
  avatar_url     String?
  fecha_registro DateTime @default(now())

  // Relaciones
  eventos_creados Evento[]
  participaciones Participante[]
}

model Evento {
  id                     String       @id @default(uuid())
  creador_id             String
  nombre                 String // Ej. "Cena en La Cumbre"
  fecha                  DateTime     @default(now())
  estado                 EstadoEvento @default(ACTIVO)
  total_gastado_centavos Int          @default(0)

  // Relaciones
  creador       Usuario        @relation(fields: [creador_id], references: [id])
  participantes Participante[]
  transacciones Transaccion[]
  consumos      Consumo[]

  @@index([creador_id])
}

model Participante {
  id        String @id @default(uuid())
  evento_id String

  // Magia de Usuarios Fantasma:
  // Si tiene la app, guardas el usuario_id. Si no, guardas el nombre_invitado.
  usuario_id      String?
  nombre_invitado String?

  monto_consumido_centavos Int @default(0)
  monto_pagado_centavos    Int @default(0)

  // Relaciones
  evento  Evento   @relation(fields: [evento_id], references: [id])
  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  // Relaciones Nombradas
  deudas_a_pagar      Transaccion[]         @relation("DeudorRelacion")
  deudas_a_cobrar     Transaccion[]         @relation("AcreedorRelacion")
  consumos_asociados  ConsumoParticipante[]

  @@index([evento_id])
  @@index([usuario_id])
  @@unique([evento_id, usuario_id])
}

model Transaccion {
  id          String @id @default(uuid())
  evento_id   String
  deudor_id   String
  acreedor_id String

  monto_centavos Int

  estado EstadoTransaccion @default(PENDIENTE)

  comprobante_url String? // Link a la foto de la transferencia
  fecha_limite    DateTime? // Temporizador de auto-aprobación

  // Auditoría
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  // Relaciones
  evento   Evento       @relation(fields: [evento_id], references: [id])
  deudor   Participante @relation("DeudorRelacion", fields: [deudor_id], references: [id])
  acreedor Participante @relation("AcreedorRelacion", fields: [acreedor_id], references: [id])

  @@index([evento_id])
  @@index([deudor_id])
  @@index([acreedor_id])
}

model Consumo {
  id             String   @id @default(uuid())
  evento_id      String
  descripcion    String? // Ej. "Pizza Suprema", "2 Cubetazos", "Nachos"
  monto_centavos Int

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  // Relaciones
  evento        Evento                @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  participantes ConsumoParticipante[]

  @@index([evento_id])
}

model ConsumoParticipante {
  id              String @id @default(uuid())
  consumo_id      String
  participante_id String
  monto_centavos  Int // Cuánto le correspondió de este consumo específico en centavos exactos

  // Relaciones
  consumo      Consumo      @relation(fields: [consumo_id], references: [id], onDelete: Cascade)
  participante Participante @relation(fields: [participante_id], references: [id], onDelete: Cascade)

  @@unique([consumo_id, participante_id])
  @@index([consumo_id])
  @@index([participante_id])
}
